# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Any Postgres 14+ works (local, Neon, Supabase, Railway…).
DATABASE_URL="postgresql://postgres:password@localhost:5432/hcm_lite?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Session lifetime in hours (default 8).
SESSION_TTL_HOURS=8

# ─── Optional: first Admin from env ──────────────────────────────────────────
# If BOTH are set, the first-run wizard only asks for the company name and creates
# this Admin account. Leave empty to type the Admin email/password in the wizard.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── AI assistant ────────────────────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
# AI_PROVIDER: "openai" (any OpenAI-compatible Chat Completions API: Groq, Google
# Gemini, OpenRouter, OpenAI…) or "anthropic" (Claude Messages API).
# Without AI_API_KEY the app still works: chat falls back to a built-in,
# clearly-labelled rule engine that calls the same permission-checked tools.
AI_PROVIDER=openai
AI_API_KEY=
# Base URL for the OpenAI-compatible provider. Examples:
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
AI_BASE_URL=https://api.groq.com/openai/v1
# Model name for the chosen provider (must support tool calling). Examples:
#   Groq: llama-3.3-70b-versatile · Gemini: gemini-2.5-flash · Anthropic: claude-opus-5-5
# (With AI_PROVIDER=anthropic, AI_BASE_URL is ignored and the official Anthropic SDK is used.)
AI_MODEL=llama-3.3-70b-versatile
# Requests per user per rolling hour (brief: ~20).
AI_RATE_LIMIT_PER_HOUR=20
